#!/bin/sh
### BEGIN INIT INFO
# Provides:          sbox
# Required-Start:    $network $remote_fs
# Required-Stop:     $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: sbox (sing-box) service
# Description:       sing-box node manager installed by sbox.sh. The sbox
#                    menu detects /etc/init.d/sbox and routes its start/stop/
#                    restart/status verbs here (backend "initd").
### END INIT INFO

DAEMON=/opt/sbox/sbox
CFG=/etc/sbox/config.json
PIDFILE=/run/sbox.pid
LOGFILE=/var/log/sbox.log

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

[ -x "$DAEMON" ] || { echo "sbox: $DAEMON not installed"; exit 0; }

is_running() {
    [ -s "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null
}

case "$1" in
    start)
        if is_running; then exit 0; fi
        mkdir -p /etc/sbox /var/tmp
        start-stop-daemon --start --background --make-pidfile --pidfile "$PIDFILE" \
            --startas /bin/sh -- -c "exec $DAEMON run -D /etc/sbox -c $CFG >>$LOGFILE 2>&1"
        sleep 1
        is_running || { echo "sbox failed to start, see $LOGFILE"; exit 1; }
        ;;
    stop)
        if is_running; then
            pid=$(cat "$PIDFILE")
            kill "$pid" 2>/dev/null
            i=0
            while [ $i -lt 20 ] && kill -0 "$pid" 2>/dev/null; do sleep 0.3; i=$((i+1)); done
            kill -9 "$pid" 2>/dev/null
            rm -f "$PIDFILE"
        else
            rm -f "$PIDFILE"
        fi
        ;;
    restart)
        "$0" stop
        sleep 1
        "$0" start
        ;;
    status)
        if is_running; then
            echo "sbox running (pid $(cat "$PIDFILE"))"
        else
            echo "sbox stopped"
            exit 3
        fi
        ;;
    enable|disable)
        exit 0
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}" >&2
        exit 1
        ;;
esac
exit 0
